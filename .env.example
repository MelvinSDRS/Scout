# Private runtime state; paths are relative to Scout's working directory.
SCOUT_DATA=data
# Optional API secret: generated in data/api-token if omitted.
# Dashboard launchers sign you in automatically; no manual token entry is needed.
# SCOUT_API_TOKEN=

# Optional outbound Telegram alerts. Create your own bot and choose its destination.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=
# Optional shared env file: only TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are read.
# SCOUT_TELEGRAM_ENV_FILE=/absolute/path/to/bot.env

# Optional local browser CDP endpoint instead of Scout's dedicated profile:
# FACEBOOK_CDP_URL=http://127.0.0.1:9222
SCAN_DELAY_SECONDS=30

# Optional reference folder root, default: data/image-references (see docs/photo-filter.md).
# SCOUT_IMAGE_REFERENCES=/absolute/path/to/reference-folders

# Defaults keep the service on loopback. See docs/deployment.md for a private proxy.
# SCOUT_BIND_HOSTS=127.0.0.1
# SCOUT_ALLOWED_HOSTS=localhost,127.0.0.1,scout.example.com
# SCOUT_TRUSTED_PROXIES=127.0.0.1
