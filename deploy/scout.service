[Unit]
Description=Scout - Facebook Marketplace watches
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@SCOUT_ROOT@
ExecStart=@SCOUT_EXECUTABLE@ serve
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
# Keep Chromium alive while the worker restores Marketplace preferences.
KillMode=mixed
# Allow the bounded 90-second Marketplace home restoration to finish on shutdown.
TimeoutStopSec=120

[Install]
WantedBy=default.target
